/*

   Necropolis - "Ghoul Peasant" cut-content character, unused right now

   Note:
      Script is almost the same as HOTGHOUL.ssl except that this one wanders around.
      Since he floats about eating a dead rat, he was probably one of the underground ghouls?

*/

/* Include Files */
#include "define.h"
#include "area/necropolis.h"

#define NAME                    SCRIPT_MEANDER
#define TOWN_REP_VAR            (GVAR_TOWN_REP_NECROPOLIS)

#include "command.h"
#include "modreact.h"

/* Standard Script Procedures */
procedure start;
procedure talk_p_proc;
procedure combat_p_proc;
procedure destroy_p_proc;
procedure timed_event_p_proc;

procedure genericend;
procedure genericcbt;
procedure generic00;
procedure generic01;
procedure generic02;
procedure generic03;

#define LVAR_Home_Tile                  (0)

variable prev_tile;
variable new_tile;
variable loopcount;
variable noevent;
variable rndx;
variable rndy;
variable dist;
variable curtime;
variable prevtime;
variable tmp_hostile;
variable MAXLEASH := 9;
variable DAY;
variable initial := 0;

procedure start begin
   if not(fo1in2_cut_characters_enabled) then destroy_object(self_obj);

   if not(initial) then begin
      initial := 1;
      if (local_var(LVAR_Home_Tile) == 0) then begin
         set_local_var(LVAR_Home_Tile, self_tile);
      end
      set_self_team(TEAM_NECROPOLIS_MINDLESS);
      set_self_ai(AI_GHOUL_NORMAL);
   end

   curtime := DAY;
   if (prevtime != curtime) then begin
      noevent := curtime;
      prevtime := curtime;
      self_walk_to_tile(local_var(LVAR_Home_Tile));
   end
end

procedure pickup_p_proc begin
   tmp_hostile := 1;
end

procedure critter_p_proc begin
   if (tmp_hostile) then begin
      tmp_hostile := 0;
      attack(dude_obj);
   end
   else begin
      loopcount := loopcount + 1;
      if (loopcount > 40) then begin
         loopcount := 0;
         if (noevent == 0) then begin
            noevent := 1;
            rndx := 5 + random(1, 10);
            add_timer_event(self_obj, game_ticks(rndx), 0);
         end
      end
   end
end

procedure destroy_p_proc begin
   inc_inv_good_crit
end

procedure talk_p_proc begin
   dude_look_at_self;

   if (tmp_hostile) then begin
      call generic01;
   end
   else begin
      call generic00;
   end
end

procedure timed_event_p_proc begin
   noevent := curtime;
   rndy := random(1, 6);
   if (rndy > 1) then begin
      dist := 2;
   end
   if (rndy > 5) then begin
      dist := 3;
   end
   prev_tile := self_tile;
   new_tile := tile_num_in_direction(prev_tile, random(0, 5), dist);
   if (tile_distance(local_var(LVAR_Home_Tile), new_tile) < MAXLEASH) then begin
      self_walk_to_tile(new_tile);
   end
end

procedure genericend begin
end

procedure genericcbt begin
end

procedure generic00 begin
   rndx := random(1, 7);
   if (rndx <= 5) then begin
      float_msg(self_obj, mstr(random(100, 104)), FLOAT_MSG_NORMAL);
   end

   if (rndx == 6) then begin
      call generic02;
   end
   if (rndx == 7) then begin
      call generic03;
   end
end

procedure generic01 begin
   float_msg(self_obj, mstr(random(105, 108)), FLOAT_MSG_LIGHT_RED);
end

procedure generic02 begin
   if (global_var(GVAR_SET_DEAD)) then begin
      float_msg(self_obj, mstr(random(109, 110)), FLOAT_MSG_NORMAL);
   end
   else begin
      float_msg(self_obj, mstr(111), FLOAT_MSG_NORMAL);
   end
end

procedure generic03 begin
   if (global_var(GVAR_NECROP_MUTANTS_KILLED) == 2) then begin
      float_msg(self_obj, mstr(random(112, 113)), FLOAT_MSG_NORMAL);
   end
   else begin
      float_msg(self_obj, mstr(114), FLOAT_MSG_NORMAL);
   end
end

procedure combat_p_proc begin
end
